# ---------------------------------------------------------------
# App
# ---------------------------------------------------------------
APP_ENV=local                 # local | production
APP_DEBUG=true                # never true in production
APP_URL=http://localhost/porfolio-2/public
# Leave empty to auto-detect (works for XAMPP subfolders and vhosts)
APP_BASE_PATH=
# Long random string (32+ chars, required in production): keys the M-Pesa
# callback URL, phone/IP hashes and rate-limit buckets. Rotating it breaks
# in-flight callbacks; see README. Generate: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=change-me
# Folder for the live, admin-edited JSON content (seeded from data/ on first run)
CONTENT_DIR=
# Proxies whose X-Forwarded-For is believed (IPs or CIDRs). Empty locally;
# docker-compose sets the Docker ranges so Traefik's header is used.
TRUSTED_PROXIES=

# ---------------------------------------------------------------
# Database (XAMPP defaults: root with an empty password)
# ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio
DB_USER=root
DB_PASS=

# Only used by docker-compose in production
DB_ROOT_PASS=change-me-root

# ---------------------------------------------------------------
# Admin (/admin). Generate the hash with: php bin/hash-password.php
# ---------------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------
# Mail (contact form). Leave MAIL_HOST empty to only store messages.
# ---------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_ENCRYPTION=tls           # tls | ssl | none
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Portfolio
MAIL_TO=you@example.com

# ---------------------------------------------------------------
# M-Pesa (Daraja). fake = no network, simulated payments (local only:
# production refuses to boot with fake). Every ledger row records this value
# and only "production" rows count towards totals.
# ---------------------------------------------------------------
MPESA_ENV=fake                # fake | sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill: the Paybill number. Till (Buy Goods): the STORE / head-office
# number Safaricom gave you, NOT the till; the passkey belongs to that store.
MPESA_SHORTCODE=174379        # sandbox default
MPESA_PASSKEY=
MPESA_TYPE=paybill            # paybill | till
MPESA_TILL_NUMBER=            # only for MPESA_TYPE=till: the till customers pay
MPESA_ACCOUNT_REF=BuyMeATea
# Public HTTPS base URL Safaricom can reach (callback is built from it)
MPESA_CALLBACK_BASE=https://example.com

# ---------------------------------------------------------------
# Production (docker-compose + Traefik)
# ---------------------------------------------------------------
SITE_DOMAIN=example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
